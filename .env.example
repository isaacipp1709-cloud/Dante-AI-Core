# Dante AI Core — Environment template
# Copy this file to .env.local or your secure environment manager.
# Never place real credentials in this file.
# Never commit .env, .env.local or production secrets.

# Token de autenticación para recibir requests desde La Casa
DANTE_CORE_TOKEN="your_secure_server_to_server_token_here"

# Conexión a Neon PostgreSQL
DATABASE_URL="postgres://user:password@hostname/dbname?sslmode=require"
USE_DATABASE="true"
